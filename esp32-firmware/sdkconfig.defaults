# PSRAM configuration
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# Keep the WebSocket client's tx/rx buffers transient (allocated per
# send/receive and freed after) instead of resident. Resident 2x96KiB
# buffers would either not fit internal RAM or - with SPIRAM_USE_MALLOC -
# steal PSRAM bandwidth from the camera's framebuffer DMA, which caused
# EV-EOF-OVF frame overflows and killed the stream every ~12s.
CONFIG_ESP_WS_CLIENT_ENABLE_DYNAMIC_BUFFER=y

# Partition table: OTA-capable with two OTA slots. Custom rather than the
# stock two-OTA template - this firmware (camera + WiFi + full TLS + HTTPS
# OTA + JSON + WebSocket client) compiles to ~1.03MB, which doesn't fit the
# template's stock 1MB app slots. The AI-Thinker board's 4MB flash chip (the
# old Arduino config used FlashSize=4M) is required to fit two larger slots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# TLS certificate bundle for HTTPS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# DTLS + SRTP extensions + X.509 creation, required by esp_peer (its README
# lists them as hard prerequisites for the WebRTC stack; X509_CREATE_C is a
# real Kconfig option from IDF v6 onward).
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL=2

# App startup
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=32

# The inert OTA check path (cJSON parse of the GitHub releases API response)
# runs on the main task; give it more headroom than the 3584B default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
